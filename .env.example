# 値はここに書かず、Cloudflare のシークレット（wrangler secret put）または手元の .env / .dev.vars（git 管理外）に設定する。

# --- データベース（Node: 未設定ならローカル PGlite data/pglite。Cloudflare: 必須。Neon の接続文字列）
DATABASE_URL=
# PostgreSQL に対して起動時にマイグレーションを自動適用する場合のみ 1（通常は `npm run migrate` を手で実行）
AUTO_MIGRATE=

# --- 掃除エンドポイント /api/cron/cleanup の Bearer（Cloudflare では Cron Trigger が scheduled() を直接呼ぶため任意）
CRON_SECRET=

# --- 公開 URL / 表示
PUBLIC_ORIGIN=
SERVICE_NAME=
SUPPORT_EMAIL=

# --- 任意（Node 常駐時）
ACCOUNT_QUOTA_BYTES=
TRUST_PROXY=
COOKIE_SECURE=
PORT=
DATA_DIR=
