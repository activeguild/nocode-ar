# 値はここに書かず、Vercel の Environment Variables（または手元の .env、git 管理外）に設定する。

# --- データベース（未設定ならローカル PGlite: data/pglite）
DATABASE_URL=
# PostgreSQL に対して起動時にマイグレーションを自動適用する場合のみ 1（通常は `npm run migrate` を手で実行）
AUTO_MIGRATE=

# --- 素材ストレージ（設定されていれば Vercel Blob、未設定ならローカルファイル data/assets）
BLOB_READ_WRITE_TOKEN=

# --- Vercel Cron（/api/cron/cleanup を保護する。Vercel が Authorization: Bearer <値> で呼ぶ）
CRON_SECRET=

# --- 公開 URL / 表示
PUBLIC_ORIGIN=
SERVICE_NAME=
SUPPORT_EMAIL=

# --- 任意
ACCOUNT_QUOTA_BYTES=
TRUST_PROXY=
COOKIE_SECURE=
PORT=
DATA_DIR=
